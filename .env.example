# =====================================================================
# SECRETS DE GOOGLE AI STUDIO (Panel "Secrets")
# =====================================================================
# 1. GEMINI_API_KEY (Obligatoria): Clave de API para el modelo Gemini y File Search.
#    AI Studio la inyecta automáticamente si está configurada en Secrets.
GEMINI_API_KEY=""

# 2. ADMIN_PASSWORD (Obligatoria para administración): Contraseña secreta para
#    acceder a las funciones de administración documental (cargar PDFs, activar/desactivar,
#    editar metadatos y eliminar documentos).
#    NOTA: Las consultas normativas son de ACCESO LIBRE para cualquier usuario sin contraseña.
ADMIN_PASSWORD=""

# 3. SESSION_SECRET (Recomendada): Clave secreta para la firma criptográfica y
#    generación de tokens de sesión del administrador. Si no se provee, el servidor
#    generará una clave efímera al iniciar.
SESSION_SECRET=""

# APP_URL: URL base pública donde se aloja el applet (inyectada por AI Studio).
APP_URL=""

# DOCS_STATE_FILE / STORE_CONFIG_FILE (Opcionales): rutas del registro de documentos y del
#    nombre del File Search Store. Apúntelas a un volumen persistente para conservar los
#    estados activo/inactivo entre redespliegues. Por defecto: raíz del proyecto.
DOCS_STATE_FILE=""
STORE_CONFIG_FILE=""
